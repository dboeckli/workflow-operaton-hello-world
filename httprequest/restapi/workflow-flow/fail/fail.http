# Flow: fail branch — start hello-world-process, verify the token and complete say-hello (BpmnError afterwards) — see ../workflow-flow.md

### 1) start process with input fail (sayHelloDelegate raises BpmnError, boundary event path)
< {%
    client.global.set("processInstanceId", "");
    client.global.set("taskId", "");
%}
< ../../../scripts/traceparent.js
POST {{host}}/restapi/workflow
Accept: application/json
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-operaton-hello-world

{
    "input": "fail"
}

> {%
    client.test("fail input still starts the process with 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("fail input returns a process instance", function () {
        client.assert(!!response.body.processInstanceId, "processInstanceId missing");
    });
    client.global.set("processInstanceId", response.body.processInstanceId);
%}

### 2) read the token variable (status/input)
< ../../../scripts/traceparent.js
GET {{host}}/engine-rest/process-instance/{{processInstanceId}}/variables/tokenVariable
Authorization: Basic {{username}} {{password}}
Accept: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-operaton-hello-world

> {%
    const token = response.body.value;
    client.log("fail token status: " + (token ? token.status : "missing") + ", input: " + (token ? token.input.inputVariable : "missing"));
    client.test("fail token variable is readable", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
        client.assert(!!token, "token value missing");
        client.assert(["STARTED", "RUNNING", "COMPLETED", "FINISHED", "BUSINESS_EXCEPTION"].indexOf(token.status) >= 0, "unexpected token status " + token.status);
        client.assert(token.input.inputVariable === "fail", "unexpected token input");
    });
%}

### 3) read the token position (activity)
< ../../../scripts/traceparent.js
GET {{host}}/engine-rest/process-instance/{{processInstanceId}}/activity-instances
Authorization: Basic {{username}} {{password}}
Accept: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-operaton-hello-world

> {%
    const root = response.body;
    const current = (root.childActivityInstances && root.childActivityInstances[0]) || (root.childTransitionInstances && root.childTransitionInstances[0]);
    client.log("fail token position: " + (current ? current.activityId : "unknown"));
    client.test("fail token is in the process", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
        client.assert(!!current, "no current activity or transition");
        client.assert(current.processInstanceId === client.global.get("processInstanceId"), "processInstanceId mismatch");
    });
%}

### 4) get the user task (say-hello)
< ../../../scripts/traceparent.js
GET {{host}}/engine-rest/task?processInstanceId={{processInstanceId}}&taskDefinitionKey=say-hello
Authorization: Basic {{username}} {{password}}
Accept: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-operaton-hello-world

> {%
    client.log("say-hello task count: " + response.body.length);
    if (response.body.length > 0) {
        client.global.set("taskId", response.body[0].id);
    }
%}

### 5) claim the user task as admin
# bruno:wait-for-task 04-get-the-user-task
< ../../../scripts/traceparent.js
POST {{host}}/engine-rest/task/{{taskId}}/claim
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-operaton-hello-world

{
    "userId": "admin"
}

> {%
    client.test("claim returns 204", function () {
        client.assert(response.status === 204, "expected 204 but got " + response.status);
    });
%}

### 6) complete the user task (triggers BpmnError in SayHelloDelegate)
< ../../../scripts/traceparent.js
POST {{host}}/engine-rest/task/{{taskId}}/complete
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-operaton-hello-world

{}

> {%
    client.test("complete returns 204 (BpmnError after user task)", function () {
        client.assert(response.status === 204, "expected 204 but got " + response.status);
    });
%}
